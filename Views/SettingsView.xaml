<!-- SettingsView.xaml -->
<UserControl
    x:Class="WallTrek.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WallTrek.Views"
    xmlns:wt="using:WallTrek.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WallTrek Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Card background + radius so the tab strip and content stand out against the
             window's Mica backdrop (a bare TabView is transparent and disappears). -->
        <TabView Grid.Row="1" x:Name="SettingsTabView" IsAddTabButtonVisible="False"
                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                 CornerRadius="8">
            <TabView.Resources>
                <!-- Make the selected tab clearly distinct from the unselected ones on the card.
                     Aliased to an existing brush (an invalid key fail-fast-crashes the TabView). -->
                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="ApplicationPageBackgroundThemeBrush"/>
            </TabView.Resources>
            <!-- General Tab -->
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer>
                    <StackPanel Spacing="15" Margin="10">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Output Directory:" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="0" PlaceholderText="Path where wallpapers will be saved" Width="350" HorizontalAlignment="Left"/>
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="BrowseButton_Click" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <CheckBox x:Name="AutoGenerateCheckBox" Content="Auto-generate wallpapers" VerticalAlignment="Center" Checked="AutoGenerateCheckBox_CheckChanged" Unchecked="AutoGenerateCheckBox_CheckChanged"/>
                            <StackPanel x:Name="AutoGenerateOptionsPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="Every" VerticalAlignment="Center"/>
                                <NumberBox x:Name="AutoGenerateHoursNumberBox" Value="6" Minimum="0.01" Maximum="10000" Width="100" VerticalAlignment="Center" SmallChange="0.5" LargeChange="1"/>
                                <TextBlock Text="hours using" VerticalAlignment="Center"/>
                                <ComboBox x:Name="AutoGenerateSourceComboBox" Width="160" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Current prompt" Tag="current"/>
                                    <ComboBoxItem Content="Random prompt" Tag="random"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to System Tray" IsChecked="True"/>
                            <CheckBox x:Name="RunOnStartupCheckBox" Content="Run on Windows Startup"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Data Location:" FontWeight="SemiBold"/>
                            <Button x:Name="OpenDataFolderButton" Content="Open WallTrek Folder" Click="OpenDataFolderButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- API Tab -->
            <TabViewItem Header="API" IsClosable="False">
                <ScrollViewer>
                    <StackPanel Spacing="15" Margin="10">
                        <StackPanel Spacing="10">
                            <TextBlock Text="OpenAI API Key:" FontWeight="SemiBold"/>
                            <TextBox x:Name="ApiKeyTextBox" PlaceholderText="Enter your OpenAI API key" Width="400" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Anthropic API Key:" FontWeight="SemiBold"/>
                            <TextBox x:Name="AnthropicApiKeyTextBox" PlaceholderText="Enter your Anthropic API key" Width="400" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Google API Key:" FontWeight="SemiBold"/>
                            <TextBox x:Name="GoogleApiKeyTextBox" PlaceholderText="Enter your Google API key" Width="400" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Stability AI API Key:" FontWeight="SemiBold"/>
                            <TextBox x:Name="StabilityApiKeyTextBox" PlaceholderText="Enter your Stability AI API key" Width="400" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="fal.ai API Key:" FontWeight="SemiBold"/>
                            <TextBox x:Name="FalApiKeyTextBox" PlaceholderText="Enter your fal.ai API key (used for video generation)" Width="400" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="DeviantArt API Settings:" FontWeight="SemiBold"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Client ID:" FontSize="14"/>
                                <TextBox x:Name="DeviantArtClientIdTextBox" PlaceholderText="Enter your DeviantArt client ID" Width="400" HorizontalAlignment="Left"/>
                                <TextBlock Text="Client Secret:" FontSize="14"/>
                                <PasswordBox x:Name="DeviantArtClientSecretPasswordBox" PlaceholderText="Enter your DeviantArt client secret" Width="400" HorizontalAlignment="Left"/>
                                <Button x:Name="ClearTokensButton" Content="Clear Tokens" Click="ClearTokensButton_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- User-defined image API hosts (no arbitrary scripting or secret fields in JSON). -->
            <TabViewItem Header="Providers" IsClosable="False">
                <ScrollViewer>
                    <StackPanel Margin="14" Spacing="10">
                        <TextBlock Text="OpenAI-compatible image providers" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Text="Add any number of independent API profiles. Keys stay encrypted for this Windows user. A successful connection test does not prove image-generation or image-edit support."/>
                        <ComboBox x:Name="ProviderProfileComboBox" Header="Saved providers"
                                  DisplayMemberPath="Label" MinWidth="370" MaxWidth="600" HorizontalAlignment="Left"
                                  SelectionChanged="ProviderProfileComboBox_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="New" Click="ProviderNew_Click"/>
                            <Button Content="Duplicate" Click="ProviderDuplicate_Click"/>
                            <Button Content="Delete" Click="ProviderDelete_Click"/>
                        </StackPanel>
                        <TextBox x:Name="ProviderNameBox" Header="Profile name" MaxLength="90" MaxWidth="550" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderBaseUrlBox" Header="Base URL (include /v1 if required)"
                                 PlaceholderText="https://gateway.example.com/v1" MaxWidth="700" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="ProviderAuthCombo" Header="Authentication" SelectedIndex="0"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Bearer token" Tag="Bearer"/>
                            <ComboBoxItem Content="x-api-key header" Tag="ApiKeyHeader"/>
                            <ComboBoxItem Content="No authentication (loopback only)" Tag="None"/>
                        </ComboBox>
                        <PasswordBox x:Name="ProviderKeyBox" Header="API key (leave empty to keep saved key)"
                                     MaxWidth="550" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="ProviderLoopbackBox" Content="Allow plain HTTP only for a local loopback server"/>
                        <TextBox x:Name="ProviderImageModelBox" Header="Generation model ID" MaxWidth="550" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderEditModelBox" Header="Edit model ID (blank = generation model)" MaxWidth="550" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderTextModelBox" Header="Optional separate text model ID (reserved for text-provider integration)" MaxWidth="550" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderGeneratePathBox" Header="Generation endpoint relative to Base URL" MaxWidth="550" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderEditPathBox" Header="Edit endpoint relative to Base URL" MaxWidth="550" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderModelsPathBox" Header="List models endpoint relative to Base URL" MaxWidth="550" HorizontalAlignment="Left"/>
                        <CheckBox x:Name="ProviderEnableEditsBox" Content="This provider declares an image edit endpoint (test separately)"/>
                        <ComboBox x:Name="ProviderEditShapeCombo" Header="Multipart image field" SelectedIndex="1" HorizontalAlignment="Left">
                            <ComboBoxItem Content="image" Tag="Image"/>
                            <ComboBoxItem Content="image[] (multiple references)" Tag="ImageArray"/>
                        </ComboBox>
                        <CheckBox x:Name="ProviderEnabledBox" Content="Show this provider in image-model selector" IsChecked="True"/>
                        <Button Content="Save provider" Click="ProviderSave_Click" HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <TextBlock x:Name="ProviderStatusTextBlock" TextWrapping="Wrap" MaxWidth="720"/>
                        <Button Content="Test connection / models (no image generated)" Click="ProviderTestConnection_Click" HorizontalAlignment="Left"/>
                        <TextBox x:Name="ProviderTestPromptBox" Header="Test prompt" Text="A calm lake at dawn, no text"
                                 MaxWidth="720" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Test image generation (may cost money)" Click="ProviderTestGenerate_Click"/>
                            <Button Content="Test edit with reference (uploads photo)" Click="ProviderTestEdit_Click"/>
                        </StackPanel>
                        <TextBox x:Name="ProviderReferencePathBox" Header="Reference file for edit test (PNG/JPG/WebP, not saved)"
                                 MaxWidth="720" HorizontalAlignment="Left"/>
                        <Image x:Name="ProviderTestPreview" MaxHeight="260" MaxWidth="540" Stretch="Uniform"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <!-- Random Prompt Tab -->
            <TabViewItem Header="Random Prompt" IsClosable="False">
                <Grid Margin="10" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left panel: Category profiles -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                            <TextBlock Text="Category Profiles" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Each profile is a JSON file of categories and values the AI draws from. Pick one to edit; the selected profile is the active one used for generation."
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="CategoryProfileComboBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="CategoryProfileComboBox_SelectionChanged"/>
                            <Button Grid.Column="1" Content="New" Click="NewCategoryProfile_Click"/>
                            <Button Grid.Column="2" Content="Rename" Click="RenameCategoryProfile_Click"/>
                            <Button Grid.Column="3" Content="Delete" Click="DeleteCategoryProfile_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" ZoomMode="Disabled" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="JsonTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     MinHeight="360"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </ScrollViewer>

                        <!-- Restore defaults, plus an LLM picker + Generate to author a category set from a prompt. -->
                        <Grid Grid.Row="3" Margin="0,10,0,0" ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="RestorePromptDefaultsButton" Content="Restore Defaults" Click="RestorePromptDefaultsButton_Click"/>
                            <wt:LlmModelSelector Grid.Column="1" x:Name="CategoryLlmSelector" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" x:Name="GenerateCategoryButton" Content="Generate" Click="GenerateCategoryProfile_Click" Style="{StaticResource AccentButtonStyle}"/>
                        </Grid>
                    </Grid>

                    <!-- Right panel: Word lists -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                            <TextBlock Text="Word Lists" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Each list is a flat text file (one word per line; lines starting with # are ignored). Pick a list to edit; the selected list seeds random prompts. Set how many words to add on the main page."
                                       TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="WordListComboBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="WordListComboBox_SelectionChanged"/>
                            <Button Grid.Column="1" Content="New" Click="NewWordList_Click"/>
                            <Button Grid.Column="2" Content="Rename" Click="RenameWordList_Click"/>
                            <Button Grid.Column="3" Content="Delete" Click="DeleteWordList_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" ZoomMode="Disabled" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="WordListTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     MinHeight="360"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </ScrollViewer>

                        <!-- Restore defaults, plus an LLM picker + Generate to author a word list from a prompt. -->
                        <Grid Grid.Row="3" Margin="0,10,0,0" ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="RestoreWordsDefaultsButton" Content="Restore Defaults" Click="RestoreWordsDefaultsButton_Click"/>
                            <wt:LlmModelSelector Grid.Column="1" x:Name="WordListLlmSelector" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" x:Name="GenerateWordListButton" Content="Generate" Click="GenerateWordList_Click" Style="{StaticResource AccentButtonStyle}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabViewItem>
        </TabView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Save Settings" Click="SaveButton_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Text="" Foreground="LimeGreen" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
