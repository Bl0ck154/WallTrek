<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WallTrek.Views.ImageGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WallTrek.Views">

    <UserControl.Resources>
        <local:FavoriteColorConverter x:Key="FavoriteColorConverter"/>
        <local:BooleanNegationConverter x:Key="BooleanNegationConverter"/>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,20,20,10" Spacing="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="← Back" Click="BackButton_Click" Margin="0,0,20,0"/>
                <TextBlock Text="Image History" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side: Filters (hidden while selecting) -->
                <StackPanel x:Name="FiltersPanel" Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <CheckBox x:Name="FavoritesOnlyCheckBox"
                              Content="Favorites Only"
                              Checked="FilterCheckBox_Changed"
                              Unchecked="FilterCheckBox_Changed"/>
                    <CheckBox x:Name="NotUploadedOnlyCheckBox"
                              Content="Not Uploaded"
                              Checked="FilterCheckBox_Changed"
                              Unchecked="FilterCheckBox_Changed"/>
                    <CheckBox x:Name="ShowArchivedCheckBox"
                              Content="Show Archived"
                              Checked="FilterCheckBox_Changed"
                              Unchecked="FilterCheckBox_Changed"/>
                </StackPanel>

                <!-- Left side: Selection actions (selection mode only) -->
                <StackPanel x:Name="SelectionActionsPanel"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Visibility="Collapsed">
                    <TextBlock x:Name="SelectionCountText"
                               Text="0 selected"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               MinWidth="80"/>
                    <Button x:Name="SelectAllButton" Content="Select All" Click="SelectAllButton_Click"/>
                    <Button x:Name="FavoriteSelectedButton" Click="FavoriteSelected_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE735;" FontSize="14"/>
                            <TextBlock Text="Favorite"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UnfavoriteSelectedButton" Click="UnfavoriteSelected_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="14"/>
                            <TextBlock Text="Unfavorite"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ArchiveSelectedButton" Click="ArchiveSelected_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14"/>
                            <TextBlock Text="Archive"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UnarchiveSelectedButton" Content="Unarchive" Click="UnarchiveSelected_Click" IsEnabled="False"/>
                    <Button x:Name="DeleteSelectedButton"
                            Click="DeleteSelected_Click"
                            IsEnabled="False"
                            Background="#C42B1C"
                            Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="Delete"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right side: Select toggle + count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <ToggleButton x:Name="SelectModeButton"
                                  Content="Select"
                                  Checked="SelectModeButton_Checked"
                                  Unchecked="SelectModeButton_Unchecked"/>
                    <TextBlock x:Name="ImageCountTextBlock"
                               Text="0/0 Images"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="20,0,20,20" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center">
                <GridView x:Name="ImagesGrid"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ImagesGrid_ItemClick"
                          SelectionChanged="ImagesGrid_SelectionChanged"
                          KeyDown="ImagesGrid_KeyDown"
                          HorizontalAlignment="Center">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:ImageGridItemViewModel">
                            <Border CornerRadius="8" BorderBrush="Gray" BorderThickness="1"
                                    Background="Transparent" Width="200" Height="200" Margin="4">
                                <Grid Background="Transparent">
                                    <Grid.ContextFlyout>
                                            <MenuFlyout Opening="ImageContextMenu_Opening">
                                                <MenuFlyoutItem Text="Set as Background"
                                                              Click="SetAsBackground_Click"
                                                              Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE91B;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Name="GenerateVideoItem"
                                                              Text="Generate Video..."
                                                              Click="GenerateVideo_Click"
                                                              Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE714;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem x:Name="UploadToDeviantArtItem"
                                                              Text="Upload to DeviantArt"
                                                              Click="UploadToDeviantArt_Click"
                                                              Tag="{x:Bind}"
                                                              IsEnabled="True"
                                                              Visibility="{x:Bind IsUploaded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert, Mode=OneWay}"/>
                                                <MenuFlyoutItem x:Name="ViewOnDeviantArtItem"
                                                              Text="View on DeviantArt"
                                                              Click="ViewOnDeviantArt_Click"
                                                              Tag="{x:Bind}"
                                                              Visibility="{x:Bind IsUploaded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                                <MenuFlyoutSeparator Visibility="{x:Bind IsUploaded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                                <MenuFlyoutItem x:Name="ToggleFavoriteItem"
                                                              Text="Add to Favorites"
                                                              Click="ToggleFavorite_Click"
                                                              Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE735;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Name="ToggleArchiveItem"
                                                              Text="Archive"
                                                              Click="ToggleArchive_Click"
                                                              Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE7B8;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Open Image"
                                                              Click="OpenImage_Click"
                                                              Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8A7;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open in file explorer"
                                                              Click="OpenInExplorer_Click"
                                                              Tag="{x:Bind}"/>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Details"
                                                              Click="Details_Click"
                                                              Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE946;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                    <!-- Video indicator (center play glyph) -->
                                    <Border Background="#80000000"
                                            CornerRadius="20"
                                            Width="40" Height="40"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE768;"
                                                FontSize="16"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Favorite indicator (top-left) -->
                                    <Border Background="#80000000"
                                            CornerRadius="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="5,5,0,0"
                                            Visibility="{x:Bind IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE735;"
                                                FontSize="12"
                                                Foreground="{x:Bind IsFavorite, Converter={StaticResource FavoriteColorConverter}, Mode=OneWay}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Upload indicator (top-right) -->
                                    <Border Background="LimeGreen"
                                            CornerRadius="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,5,5,0"
                                            Visibility="{x:Bind IsUploaded, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE72E;"
                                                FontSize="12"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Archived indicator (bottom-right) -->
                                    <Border Background="#80000000"
                                            CornerRadius="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,5,5"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsArchived, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE7B8;"
                                                FontSize="12"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Uploading indicator (top-right) -->
                                    <Border Background="Orange"
                                            CornerRadius="12"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,5,5,0"
                                            Visibility="{x:Bind IsUploading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE916;"
                                                FontSize="12"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,20,0,0">
                    <Button x:Name="LoadMoreButton"
                            Content="Load Next 100"
                            Click="LoadMoreButton_Click"
                            Visibility="Collapsed"
                            MinWidth="150"/>
                    <Button x:Name="LoadAllButton"
                            Content="Load All"
                            Click="LoadAllButton_Click"
                            Visibility="Collapsed"
                            MinWidth="150"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Full screen image/video popup -->
        <Border x:Name="FullScreenOverlay" Grid.RowSpan="2" Background="Black" Opacity="0.9"
                Visibility="Collapsed" Tapped="FullScreenOverlay_Tapped" KeyDown="FullScreenOverlay_KeyDown"
                PointerPressed="FullScreenOverlay_PointerPressed"
                IsTabStop="True" AllowFocusOnInteraction="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar above the image -->
                <Grid Grid.Row="0" Padding="10,8">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button x:Name="FullScreenFavoriteButton" Click="FullScreenFavorite_Click"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <FontIcon x:Name="FullScreenFavoriteIcon" Glyph="&#xE735;" Foreground="White"/>
                                <TextBlock Text="F" FontSize="9" Foreground="#B0FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullScreenArchiveButton" Click="FullScreenArchive_Click"
                                Background="Transparent" BorderThickness="0">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <FontIcon x:Name="FullScreenArchiveIcon" Glyph="&#xE7B8;" Foreground="White"/>
                                <TextBlock Text="A" FontSize="9" Foreground="#B0FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullScreenSetBackgroundButton" Click="FullScreenSetBackground_Click"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Set as Background">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <FontIcon Glyph="&#xE91B;" Foreground="White"/>
                                <TextBlock Text="B" FontSize="9" Foreground="#B0FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FullScreenDeleteButton" Click="FullScreenDelete_Click"
                                Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Delete">
                            <StackPanel HorizontalAlignment="Center" Spacing="1">
                                <FontIcon Glyph="&#xE74D;" Foreground="White"/>
                                <TextBlock Text="Del" FontSize="9" Foreground="#B0FFFFFF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="FullScreenPositionText"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="White" FontWeight="SemiBold" Margin="0,0,10,0"/>
                </Grid>

                <!-- Media with nav arrows on the sides -->
                <Grid Grid.Row="1">
                    <Image x:Name="FullScreenImage" Stretch="Uniform" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Tapped="FullScreenImage_Tapped"/>
                    <MediaPlayerElement x:Name="FullScreenVideo" Stretch="Uniform" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" AreTransportControlsEnabled="False"
                                        AutoPlay="True" Visibility="Collapsed" Tapped="FullScreenImage_Tapped"/>
                    <Button x:Name="FullScreenPrevButton" Click="FullScreenPrev_Click"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                            Width="48" Height="48" CornerRadius="24"
                            Background="#60000000" BorderThickness="0">
                        <FontIcon Glyph="&#xE76B;" Foreground="White"/>
                    </Button>
                    <Button x:Name="FullScreenNextButton" Click="FullScreenNext_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                            Width="48" Height="48" CornerRadius="24"
                            Background="#60000000" BorderThickness="0">
                        <FontIcon Glyph="&#xE76C;" Foreground="White"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
