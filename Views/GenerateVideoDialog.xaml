<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WallTrek.Views.GenerateVideoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MinWidth="440">
        <TextBlock Text="Creates a short video from this image. The image is used as both the first and last frame, so the clip loops seamlessly."
                   TextWrapping="Wrap" FontSize="12" Opacity="0.7"/>

        <StackPanel Spacing="6">
            <TextBlock Text="Model:" FontWeight="SemiBold"/>
            <ComboBox x:Name="ModelComboBox" HorizontalAlignment="Stretch"
                      SelectionChanged="ModelComboBox_SelectionChanged"/>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Duration:" FontWeight="SemiBold"/>
                <ComboBox x:Name="DurationComboBox" HorizontalAlignment="Stretch"
                          SelectionChanged="Option_SelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Upscale:" FontWeight="SemiBold"/>
                <ComboBox x:Name="UpscaleComboBox" HorizontalAlignment="Stretch"
                          SelectionChanged="Option_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Motion prompt:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="SuggestPromptButton" Padding="4" Click="SuggestPromptButton_Click"
                        ToolTipService.ToolTip="Suggest a motion prompt from the image's prompt (AI)">
                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                </Button>
            </StackPanel>
            <TextBox x:Name="MotionPromptTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="80" MaxHeight="140" TextChanged="MotionPromptTextBox_TextChanged"
                     PlaceholderText="Describe the motion for the loop, or use the button above to suggest one"/>
        </StackPanel>

        <TextBlock x:Name="PriceEstimateText" FontWeight="SemiBold"/>

        <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
            <ProgressRing x:Name="ProgressSpinner" IsActive="False" Width="20" Height="20"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
        </StackPanel>
    </StackPanel>
</UserControl>
