<!-- MainView.xaml -->
<UserControl
    x:Class="WallTrek.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WallTrek.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:wt="using:WallTrek.Views.Controls"
    xmlns:imagegen="using:WallTrek.Services.ImageGen"
    mc:Ignorable="d">

        <UserControl.Resources>
        <!-- Shared height for every control on the LLM and Image-Model rows so the combos,
             multi-selects, and buttons all line up. 36 leaves room for the item-template
             padding (a stock 32 clips the templated combos). -->
        <x:Double x:Key="RowControlHeight">36</x:Double>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="26,16,26,24" MaxWidth="1160" HorizontalAlignment="Center" Spacing="14">
                <!-- Page headline is compact and aligned to the form, not floating above it. -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Create a wallpaper" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Write a scene, add your photos, choose an image model." FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="WALLTREK STUDIO" FontWeight="SemiBold" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>

                <!-- Prompt: a single obvious entry area, with optional complexity tucked away. -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="01  PROMPT" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="What should the wallpaper look like?" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Button x:Name="RandomPromptButton"
                        Content="Generate Prompt"
                        Click="RandomPromptButton_Click"
                        Height="{StaticResource RowControlHeight}"
                        VerticalAlignment="Bottom"
                        MinWidth="120"/></StackPanel>
                        </Grid>
                        <TextBox x:Name="PromptTextBox"
                     PlaceholderText="Enter a description for your wallpaper or click generate prompt above..."
                     Height="138"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     KeyDown="PromptTextBox_KeyDown"
                     TextChanged="PromptTextBox_TextChanged"/>
                        <Border CornerRadius="8" Padding="10,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="6">
                                <Button Content="Photos &amp; scenarios" Click="PersonalizationEditor_Click"/>
                                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PersonalizationStatusText" Text="Personalization off"
                           VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                            </controls:WrapPanel>
                        </Border>
                        <ItemsControl x:Name="PropertiesBadgesControl" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource SystemFillColorNeutralBrush}"
                                CornerRadius="4"
                                Padding="8,3">
                            <TextBlock Text="{Binding}"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                        <Expander Header="Advanced prompt tools  /  model, word lists, variations" IsExpanded="False">
                            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12" Margin="8,12,8,12">
                                <StackPanel Width="250" Spacing="5"><TextBlock Text="Text model (LLM)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><wt:MultiSelectComboBox x:Name="LlmSelectionControl"
                                            Width="250"
                                            Height="{StaticResource RowControlHeight}"
                                            VerticalAlignment="Bottom"
                                            SelectionChanged="LlmSelectionControl_SelectionChanged">
                        <wt:MultiSelectComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Model}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PerPrompt}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </wt:MultiSelectComboBox.ItemTemplate>
                    </wt:MultiSelectComboBox></StackPanel>
                                <StackPanel Width="172" Spacing="5"><TextBlock Text="Category sets" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><wt:MultiSelectComboBox x:Name="CategoryProfileSelectionControl"
                                            Width="172"
                                            Height="{StaticResource RowControlHeight}"
                                            VerticalAlignment="Bottom"
                                            SelectionChanged="CategoryProfileSelectionControl_SelectionChanged">
                        <wt:MultiSelectComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Padding="2,3"/>
                            </DataTemplate>
                        </wt:MultiSelectComboBox.ItemTemplate>
                    </wt:MultiSelectComboBox></StackPanel>
                                <StackPanel Width="172" Spacing="5"><TextBlock Text="Word lists" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><wt:MultiSelectComboBox x:Name="WordListSelectionControl"
                                            Width="172"
                                            Height="{StaticResource RowControlHeight}"
                                            VerticalAlignment="Bottom"
                                            SelectionChanged="WordListSelectionControl_SelectionChanged">
                        <wt:MultiSelectComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Padding="2,3"/>
                            </DataTemplate>
                        </wt:MultiSelectComboBox.ItemTemplate>
                    </wt:MultiSelectComboBox></StackPanel>
                                <StackPanel Width="108" Spacing="5"><TextBlock Text="Random words" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><wt:MultiSelectComboBox x:Name="WordCountSelectionControl"
                                            Width="108"
                                            Height="{StaticResource RowControlHeight}"
                                            VerticalAlignment="Bottom"
                                            SelectionChanged="WordCountSelectionControl_SelectionChanged"
                                            ToolTipService.ToolTip="How many random words to add to the prompt (0 = none); check several to pick one at random per generation">
                        <wt:MultiSelectComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="2,3"/>
                            </DataTemplate>
                        </wt:MultiSelectComboBox.ItemTemplate>
                    </wt:MultiSelectComboBox></StackPanel>
                                <StackPanel Width="118" Spacing="5"><TextBlock Text="Iterative mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><CheckBox
                              x:Name="IterativePromptCheckBox"
                              Content="On"
                              Height="{StaticResource RowControlHeight}"
                              VerticalAlignment="Bottom"
                              VerticalContentAlignment="Center"
                              Checked="IterativePromptCheckBox_Changed"
                              Unchecked="IterativePromptCheckBox_Changed"
                              ToolTipService.ToolTip="Generate once per random word. Each call picks one of the selected LLMs and revises the previous prompt with the next word; only the final prompt is used. Example: 4 words = 4 LLM calls."/></StackPanel>
                            </controls:WrapPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Image controls stay together; primary action no longer falls between sections. -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="02  GENERATION" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Choose an engine and render" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                            <StackPanel Width="440" Spacing="5"><TextBlock Text="Image model" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><wt:MultiSelectComboBox x:Name="ImageModelSelectionControl"
                                            Width="440"
                                            Height="{StaticResource RowControlHeight}"
                                            VerticalAlignment="Bottom"
                                            SelectionChanged="ImageModelSelectionControl_SelectionChanged">
                        <wt:MultiSelectComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="14" Padding="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Model}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quality}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Dimensions}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Price}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </wt:MultiSelectComboBox.ItemTemplate>
                    </wt:MultiSelectComboBox></StackPanel>
                            <StackPanel Width="286" Spacing="5"><TextBlock Text="Upscale" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ComboBox x:Name="UpscalerSelectionComboBox"
                              Height="{StaticResource RowControlHeight}"
                              VerticalAlignment="Bottom"
                              SelectionChanged="UpscalerSelectionComboBox_SelectionChanged"
                              Width="286">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="imagegen:UpscalerOption">
                                <Grid ColumnSpacing="12" Padding="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Price}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox></StackPanel>
                            <StackPanel Spacing="5" Width="162">
                                <TextBlock Text=" " FontSize="12"/>
                                <SplitButton x:Name="GenerateButton"
                             Content="Generate Image"
                             Click="GenerateButton_Click"
                             Height="{StaticResource RowControlHeight}"
                             VerticalAlignment="Bottom"
                             MinWidth="120">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Generate 2 images" Tag="2" Click="GenerateBatchMenuItem_Click"/>
                            <MenuFlyoutItem Text="Generate 4 images" Tag="4" Click="GenerateBatchMenuItem_Click"/>
                            <MenuFlyoutItem Text="Generate 8 images" Tag="8" Click="GenerateBatchMenuItem_Click"/>
                            <MenuFlyoutItem Text="Generate 16 images" Tag="16" Click="GenerateBatchMenuItem_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Custom…" Tag="custom" Click="GenerateBatchMenuItem_Click"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                            </StackPanel>
                        </controls:WrapPanel>
                        <TextBlock x:Name="CostEstimateTextBlock"
                       HorizontalAlignment="Left"
                       Foreground="Gray"
                       FontSize="12"/>
                        <ProgressBar x:Name="GenerationProgressBar"

                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Height="6"
                     VerticalAlignment="Top"
                     Margin="0,10"/>
                    </StackPanel>
                </Border>

                <!-- Nearby secondary actions, never stranded at the bottom of a tall window. -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="10">
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <SplitButton x:Name="RandomImageButton"
                             Content="Random Image"
                             Click="RandomImageButton_Click"
                             MinWidth="170">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Generate 2 images" Tag="2" Click="RandomBatchMenuItem_Click"/>
                            <MenuFlyoutItem Text="Generate 4 images" Tag="4" Click="RandomBatchMenuItem_Click"/>
                            <MenuFlyoutItem Text="Generate 8 images" Tag="8" Click="RandomBatchMenuItem_Click"/>
                            <MenuFlyoutItem Text="Generate 16 images" Tag="16" Click="RandomBatchMenuItem_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Custom…" Tag="custom" Click="RandomBatchMenuItem_Click"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
                            <Button x:Name="CancelButton"
                        Content="Cancel"
                        Click="CancelButton_Click"
                        Visibility="Collapsed"
                        MinWidth="100"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        Foreground="White"/>
                            <Button x:Name="ImageGridButton"
                        Content="Image History"
                        Click="ImageGridButton_Click"
                        MinWidth="100"/>
                            <Button x:Name="OpenFolderButton"
                        Content="Open Image Folder"
                        Click="OpenFolderButton_Click"
                        MinWidth="100"/>
                            <Button x:Name="SettingsButton"
                        Content="Settings"
                        Click="SettingsButton_Click"
                        MinWidth="100"/>
                        </controls:WrapPanel>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StatusTextBlock"

                   Text="Ready to generate wallpaper"
                   HorizontalAlignment="Left"
                   Foreground="Gray"
                   Margin="0,10,0,0"/>
                            <TextBlock x:Name="NextGenerateTextBlock"

                   Text=""
                   HorizontalAlignment="Left"
                   Foreground="Gray"
                   FontSize="12"
                   Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
