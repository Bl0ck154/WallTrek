<UserControl
    x:Class="WallTrek.Views.PersonalizationEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640" MinWidth="610">
        <StackPanel Spacing="14" Padding="8">
            <TextBlock Text="Personalized wallpapers" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Text="Keep your photos local. Only approved, sanitized copies are sent to the selected image provider; the original images are never uploaded. Face consistency is best effort."/>
            <Expander Header="Reference photo library (1–5 enabled)" IsExpanded="True">
                <StackPanel Spacing="8" Padding="6">
                    <Button Content="Import up to 5 photos…" Click="ImportPhotos_Click" HorizontalAlignment="Left"/>
                    <ListView x:Name="PhotoList" Height="128" SelectionChanged="PhotoList_SelectionChanged"
                              DisplayMemberPath="Label"/>
                    <Image x:Name="PhotoPreview" Width="190" Height="120" Stretch="Uniform"
                           HorizontalAlignment="Left"/>
                    <TextBox x:Name="PhotoLabel" Header="Photo label" MaxLength="100"/>
                    <ComboBox x:Name="PhotoRole" Header="Reference role" SelectedIndex="0"
                              HorizontalAlignment="Left">
                        <ComboBoxItem Content="Identity / face" />
                        <ComboBoxItem Content="Content / pose" />
                        <ComboBoxItem Content="Style only" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox x:Name="PhotoEnabled" Content="Use this photo"/>
                        <CheckBox x:Name="PhotoPrimary" Content="Primary portrait"/>
                    </StackPanel>
                    <CheckBox x:Name="ConfirmDeletePhoto" Content="I confirm deletion of the selected photo and its stored original"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save photo settings" Click="SavePhoto_Click"/>
                        <Button Content="Delete from library" Click="DeletePhoto_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander Header="Scenario editor" IsExpanded="True">
                <StackPanel Spacing="8" Padding="6">
                    <ComboBox x:Name="ScenarioList" Header="Saved scenarios"
                              DisplayMemberPath="Name" HorizontalAlignment="Left"
                              MinWidth="340" SelectionChanged="ScenarioList_SelectionChanged"/>
                    <CheckBox x:Name="ConfirmDeleteScenario" Content="I confirm deletion of the selected scenario"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="New scenario" Click="NewScenario_Click"/>
                        <Button Content="Delete scenario" Click="DeleteScenario_Click"/>
                    </StackPanel>
                    <TextBox x:Name="ScenarioName" Header="Scenario name"/>
                    <TextBox x:Name="ScenarioTemplate" Header="Prompt template (use {{place}} variables)"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="90"/>
                    <TextBox x:Name="ScenarioPools" Header="Variations: one line per variable, e.g. place = Prague | Vienna | Tokyo"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="105"/>
                    <TextBox x:Name="ScenarioStyle" Header="Style and composition instructions"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="65"/>
                    <TextBox x:Name="ScenarioAvoid" Header="Avoid / exclusions"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="55"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save and activate" Click="SaveScenario_Click"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Turn personalization off" Click="DisableScenario_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ScenarioActiveLabel" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
            <Expander Header="Preview and private photo upload approval" IsExpanded="True">
                <StackPanel Spacing="9" Padding="6">
                    <Button Content="Preview next final prompt" Click="PreviewNext_Click"
                            HorizontalAlignment="Left"/>
                    <TextBox x:Name="FinalPrompt" Header="Exactly what will be sent"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Height="160"/>
                    <TextBlock x:Name="VariationLabel" TextWrapping="Wrap"/>
                    <ComboBox x:Name="DestinationProfiles" Header="Allow photo transfer to this specific provider"
                              MinWidth="400" HorizontalAlignment="Left"
                              DisplayMemberPath="Label" SelectionChanged="DestinationProfiles_SelectionChanged"/>
                    <CheckBox x:Name="ConfirmUpload" Content="I consent to uploading sanitized photos to the selected provider (host shown above)"/>
                    <Button Content="Approve these photos for this provider" Click="ApproveDestination_Click"
                            HorizontalAlignment="Left"/>
                    <TextBlock TextWrapping="Wrap" Text="Codex (experimental) sends sanitized photos to ChatGPT through an unofficial helper. The helper reads your existing local Codex login, uses undocumented endpoints and may consume account quota. WallTrek does not copy tokens. The helper supports at most one style photo plus an identity/content photo. Local sign-in alone does not prove image access."/>
                    <Button Content="Check Codex login/helper (no image generated)" Click="ProbeCodex_Click"
                            HorizontalAlignment="Left"/>
                    <Button Content="Test Codex edit with approved photos (uses account quota)"
                            Click="TestCodexEdit_Click" HorizontalAlignment="Left"/>
                    <Image x:Name="CodexEditPreview" MaxHeight="200" MaxWidth="420"
                           Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock TextWrapping="Wrap" Text="Consent is bound to the selected scenario, photo roles/IDs and exact destination origin. Switching the destination requires approval. No automatic vendor fallback."/>
                </StackPanel>
            </Expander>
            <Expander Header="Recent personalized wallpaper history">
                <StackPanel Spacing="8" Padding="6">
                    <Button Content="Refresh history" Click="RefreshHistory_Click" HorizontalAlignment="Left"/>
                    <ListView x:Name="RunHistoryList" Height="140" DisplayMemberPath="Display"
                              SelectionChanged="HistoryList_SelectionChanged"/>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" MaxWidth="580"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>